{
  "manifest_version": 3,
  "version": "2.1.0",
  "name": "Skies — World Clock & Time Zones",
  "short_name": "Skies",
  "description": "View multiple city time zones in one popup—now with a built-in Time Converter for instant cross-time-zone planning.",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/logos/logo-16.png",
      "32": "icons/logos/logo-32.png",
      "48": "icons/logos/logo-48.png",
      "128": "icons/logos/logo-128.png"
    }
  },
  "icons": {
    "16": "icons/logos/logo-16.png",
    "32": "icons/logos/logo-32.png",
    "48": "icons/logos/logo-48.png",
    "128": "icons/logos/logo-128.png"
  }
}
